{
	# Disable the admin API — not needed for this setup.
	admin off

	# Plain HTTP by default. With TLS on (llm_tls_hostnames in Ansible), the
	# pod sets LLM_AUTO_HTTPS=disable_redirects: certificates, but no
	# HTTP-to-HTTPS redirect, since both would need port 8080.
	auto_https {$LLM_AUTO_HTTPS:off}
}

# Site address: ":8080" (plain HTTP, any host name) by default. With TLS on,
# LLM_SITE_ADDRESS lists the host names and IPs to issue certificates for,
# each with :8080.
{$LLM_SITE_ADDRESS::8080} {
	# ── TLS (off by default) ───────────────────────────────────────────
	# WARNING: without TLS, the Open WebUI login and the Bearer token cross
	# the network in clear text. Keep port 8080 on a LAN or VPN, or set
	# llm_tls_hostnames so the pod sets LLM_TLS to "tls internal":
	# certificates from Caddy's own local CA, which clients must trust.
	{$LLM_TLS}

	# ── Ollama API — Bearer token protected ────────────────────────────
	# Prefixed with /ollama/ to avoid conflicting with Open WebUI's own /api/.
	# Clients: use http://<host>:8080/ollama/api/ and /ollama/v1/
	@ollama_api {
		path /ollama/api /ollama/api/* /ollama/v1 /ollama/v1/*
	}

	handle @ollama_api {
		# Reject requests without the correct Bearer token.
		@unauthorized not header Authorization "Bearer {$OLLAMA_API_KEY}"
		respond @unauthorized "Unauthorized" 401

		# Strip the /ollama prefix before forwarding to Ollama.
		uri strip_prefix /ollama

		# Forward authenticated requests to Ollama (localhost — shared pod network).
		reverse_proxy localhost:11434 {
			# Pass the client's real IP for logging.
			header_up X-Real-IP {remote_host}
			# Strip the Authorization header before forwarding — Ollama
			# doesn't need it and we don't want it in logs.
			header_up -Authorization
		}
	}

	# ── SearXNG — Bearer token protected ──────────────────────────────
	# Clients: use http://<host>:8080/searxng/ with the SearXNG API key,
	# which is separate from the Ollama one.
	@searxng {
		path /searxng /searxng/*
	}

	handle @searxng {
		# Reject requests without the correct Bearer token.
		@unauthorized not header Authorization "Bearer {$SEARXNG_API_KEY}"
		respond @unauthorized "Unauthorized" 401

		uri strip_prefix /searxng
		reverse_proxy localhost:8888 {
			header_up X-Real-IP {remote_host}
			header_up -Authorization
		}
	}

	# ── Open WebUI — no extra auth (has its own account system) ────────
	# Open WebUI runs on port 3000 (not 8080) to avoid conflicting with Caddy.
	handle {
		reverse_proxy localhost:3000 {
			header_up X-Real-IP {remote_host}
		}
	}

	# ── Logging ────────────────────────────────────────────────────────
	log {
		output stderr
		format console
		level INFO
	}
}
