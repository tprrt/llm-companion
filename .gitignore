llm-companion-secrets.yml
*-secrets.yml
# Catch-all for any *.env secret file generated under this convention
*-key.env
*-secret.env

# ── Ansible inventory — contains host-specific config ─────────────────────────
ansible/inventory/hosts.yml
ansible/inventory/host_vars/

# ── VM test artifacts ─────────────────────────────────────────────────────────
vm-test/

# ── Editor and OS files ───────────────────────────────────────────────────────
.DS_Store
*.swp
*.swo
*~
