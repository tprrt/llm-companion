# =============================================================================
# Modelfile.laguna-xs-2.1 — Laguna XS 2.1 with 32k context
#
# MoE model: 33B total parameters, 3B active per token, built for agentic
# coding and long-horizon work. Faster tokens than the dense Qwen3.8 27B at a
# similar VRAM cost.
#
# TARGET: NVIDIA CUDA host with ≥ 24 GB VRAM (e.g. RTX 3090 / 4090, A5000).
#
# Memory guide (Q4_K_M, ≈ 20 GB base — all experts must be loaded):
#   16k ctx → ~22 GB total  → needs 24 GB VRAM
#   32k ctx → ~24 GB total  → needs 24 GB VRAM (tight on 24 GB cards)
#
# Create with:
#   podman cp Modelfile.laguna-xs-2.1 llm-companion-ollama:/tmp/
#   podman exec -it llm-companion-ollama ollama create laguna-xs-2.1-32k \
#       -f /tmp/Modelfile.laguna-xs-2.1
#
# pull-models.sh does this automatically.
# =============================================================================

FROM laguna-xs-2.1

# 32k fits whole files + tool call history without truncation.
# Drop to 16384 if you hit OOM on a 24 GB card.
PARAMETER num_ctx 32768

# Low temperature for deterministic, reliable code generation.
PARAMETER temperature 0.15
