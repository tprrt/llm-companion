{# Source template: Ansible renders it per host; scripts/render-stack.sh renders it by hand. #}

# =============================================================================
# stack.yml — Kubernetes Pod manifest for the llm-companion stack
#
# Rendered from kube/stack.yml.j2 for ollama_build_target={{ ollama_build_target }}.
# Edit the template, not this file: the next playbook run overwrites it.
#
# Contains (in order):
#   1. PersistentVolumeClaims (ollama-models, open-webui-data,
#      open-terminal-data, caddy-data)
#   2. ConfigMap with the Caddyfile (from caddy/Caddyfile) and SearXNG settings
#   3. Pod with five containers: ollama, open-webui, open-terminal, searxng,
#      caddy
#
# Pod mode (single-pod networking):
#   All containers share the same network namespace. They communicate
#   via localhost (127.0.0.1), not via DNS names.
#     - Ollama listens on localhost:11434
#     - Open WebUI listens on localhost:3000  (not 8080 — Caddy owns :8080)
#     - Caddy listens on localhost:8080 and is the only container with a
#       hostPort published to the outside world.
#
# Ollama variants (ollama_build_target):
#   cpu   localhost/ollama-cpu image, 16k default context, no capabilities.
#   rocm  localhost/ollama-rocm image, 32k default context, privileged for
#         /dev/kfd and /dev/dri access in rootless Podman. Host prerequisites:
#           sudo usermod -aG render,video $USER   # log out and back in
#           sudo dnf install rocm-hip rocm-opencl rocm-smi
#   cuda  localhost/ollama-cuda image, 32k default context, GPUs requested
#         through CDI (nvidia.com/gpu=all); the podman Ansible role installs
#         the NVIDIA Container Toolkit and generates the CDI spec.
#
# PVC behaviour:
#   podman play kube  → creates named Podman volumes (stored in ~/.local/share/
#                        containers/storage/volumes/). No StorageClass needed.
#   k3s / Kubernetes  → PVCs are created in the cluster; a StorageClass (e.g.
#                        local-path) must be configured.
#
# How to apply by hand (Fedora / rootless Podman):
#   ./scripts/render-stack.sh cpu > ~/.config/containers/systemd/stack.yml
#   podman play kube ~/.config/containers/systemd/llm-companion-secrets.yml
#   podman play kube ~/.config/containers/systemd/stack.yml --replace
#   # Or let the llm-companion.kube Quadlet manage it via systemd.
# =============================================================================
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: llm-ollama-models
  labels:
    app: llm-companion
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 100Gi

---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: llm-open-webui-data
  labels:
    app: llm-companion
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 5Gi

---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: llm-open-terminal-data
  labels:
    app: llm-companion
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 10Gi

---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: llm-caddy-data
  labels:
    app: llm-companion
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 1Gi

---
# ConfigMap with the Caddyfile and SearXNG settings.
# All addresses use localhost because all containers share the pod network namespace.
# The Caddyfile is caddy/Caddyfile, inserted at render time.
apiVersion: v1
kind: ConfigMap
metadata:
  name: llm-companion-config
  labels:
    app: llm-companion
data:
  Caddyfile: |
{{ lookup('ansible.builtin.file', llm_repo_dir ~ '/caddy/Caddyfile') | replace('\t', '  ') | indent(4, first=true) }}

  searxng-settings.yml: |
    use_default_settings: true

    server:
      limiter: false
      image_proxy: false

    search:
      safe_search: 0
      formats:
        - html
        - json

---
apiVersion: v1
kind: Pod
metadata:
  name: llm-companion
  labels:
    app: llm-companion
  annotations:
    # Podman rootless extension: map the container user to the host user.
    # This is equivalent to --userns=keep-id in podman run.
    io.podman.annotations.userns: "keep-id"
spec:
  automountServiceAccountToken: false
  restartPolicy: Always

  initContainers:
    # Guards against stale pre-Alembic databases after an image upgrade.
    # Open WebUI switched to Alembic-based migrations in the 0.x→0.9 series.
    # Existing databases created before that switch have no alembic_version
    # table; Open WebUI's own migration runner can't recover from that state
    # and serves 500s instead of completing the migration.
    # This container detects the missing-alembic_version condition and backs
    # up + removes the database so Open WebUI initialises a clean schema on
    # its next startup. It intentionally avoids importing the Open WebUI app
    # (which would pull in the full dependency chain and OOM) and uses only
    # stdlib sqlite3.
    - name: open-webui-db-guard # NOSONAR — S6864/S6870/S6873/S6892/S6897 inapplicable
      image: ghcr.io/open-webui/open-webui:v0.13.5 # keep in sync with the open-webui container below
      command:
        - python3
        - -c
        - |
          import sqlite3, os, shutil
          db = '/app/backend/data/webui.db'
          if not os.path.exists(db):
              print('No DB — fresh start, nothing to do')
          else:
              try:
                  c = sqlite3.connect(db)
                  c.execute('SELECT version_num FROM alembic_version').fetchone()
                  c.close()
                  print('Alembic tracking present — Open WebUI will apply any pending migrations on startup')
              except sqlite3.OperationalError as e:
                  bak = db + '.pre-alembic.bak'
                  print(f'No alembic_version table ({e}): stale pre-Alembic DB detected')
                  print(f'Backing up to {bak} and removing so Open WebUI initialises a clean schema')
                  shutil.copy2(db, bak)
                  os.remove(db)
      resources:
        requests:
          cpu: 50m
          memory: 64Mi
        limits:
          cpu: 100m
          memory: 128Mi
      volumeMounts:
        - name: open-webui-data
          mountPath: /app/backend/data

  containers:
    # ── Ollama ───────────────────────────────────────────────────────────────
    - name: ollama # NOSONAR — Podman pod, not Kubernetes; S6864/S6870/S6873/S6892/S6897 are inapplicable
      image: localhost/ollama-{{ ollama_build_target }}:latest # NOSONAR — S6596: locally built image pinned at build time, no registry tag needed
      env:
        # Listen on all interfaces within the pod network namespace.
        - name: OLLAMA_HOST
          value: "0.0.0.0:11434"
{% if ollama_build_target == 'cpu' %}
        - name: OLLAMA_CONTEXT_LENGTH
          value: "16384"
{% else %}
        # Larger context window for the 32k GPU models (e.g. Qwen3.8 27B).
        - name: OLLAMA_CONTEXT_LENGTH
          value: "32768"
{% endif %}
        - name: OLLAMA_KEEP_ALIVE
          value: "10m"
        # Room for the chat, task and embedding models at once: with 1, every
        # Open WebUI title or search query unloaded the chat model and the
        # next chat turn paid a reload (17 s vs 4.5 s on a laptop CPU).
        # Ollama still unloads models when memory runs short.
        - name: OLLAMA_MAX_LOADED_MODELS
          value: "3"
        # Pod mode: containers communicate via localhost, not DNS names.
        - name: OLLAMA_ORIGINS
          value: "http://localhost:8080"
        - name: ANONYMIZED_TELEMETRY
          value: "false"
{% if ollama_build_target == 'rocm' %}
        # Expose all ROCm-capable GPUs to Ollama.
        - name: ROCR_VISIBLE_DEVICES
          value: "all"
{% if ollama_hsa_override_gfx_version %}
        # GFX version override for GPUs ROCm does not support directly.
        - name: HSA_OVERRIDE_GFX_VERSION
          value: "{{ ollama_hsa_override_gfx_version }}"
{% endif %}
{% endif %}
      livenessProbe:
        exec:
          command:
            - ollama
            - list
        initialDelaySeconds: 10
        periodSeconds: 30
        timeoutSeconds: 10
      readinessProbe:
        exec:
          command:
            - ollama
            - list
        initialDelaySeconds: 10
        periodSeconds: 10
        timeoutSeconds: 10
{% if ollama_build_target == 'rocm' %}
      securityContext:
        # privileged: true is required for rootless Podman to access /dev/kfd
        # and /dev/dri (AMD GPU devices). Without this, ROCm cannot enumerate
        # the GPU and Ollama falls back to CPU inference.
        #
        # For k3s: replace this with the AMD GPU device plugin:
        #   resources:
        #     limits:
        #       amd.com/gpu: "1"
        # and remove privileged: true.
        privileged: true # NOSONAR — S6428: required for rootless Podman to access /dev/kfd and /dev/dri; replaced by AMD GPU device plugin in k3s
{% else %}
{% if ollama_build_target == 'cuda' %}
      resources:
        limits:
          "nvidia.com/gpu=all": 1 # NOSONAR — S6428: CDI GPU device request; requires the NVIDIA Container Toolkit + generated CDI spec (see ansible/roles/podman)
{% endif %}
      securityContext:
        # Drop all capabilities for least-privilege operation.{{ ' CDI injects the\n        # GPU device nodes and libraries; Ollama needs no capability to use them.' if ollama_build_target == 'cuda' else '' }}
        capabilities:
          drop:
            - ALL
{% endif %}
      volumeMounts:
        - name: ollama-models
          mountPath: /var/lib/ollama/models

    # ── Open WebUI ───────────────────────────────────────────────────────────
    - name: open-webui # NOSONAR — Podman pod, not Kubernetes; S6864/S6870/S6873/S6892/S6897 are inapplicable
      image: ghcr.io/open-webui/open-webui:v0.13.5
      env:
        # Open WebUI binds on port 3000 (not 8080) to avoid conflicting with Caddy.
        - name: PORT
          value: "3000"
        # Pod mode: Ollama is reachable on localhost within the shared network namespace.
        - name: OLLAMA_BASE_URL
          value: "http://localhost:11434"
        - name: ANONYMIZED_TELEMETRY
          value: "false"
        - name: ENABLE_SIGNUP
          value: "true"
        # New sign-ups stay pending until an admin approves them: anyone who can
        # reach :8080 can register, and an active user gets the models and,
        # once connected, Open Terminal's shell.
        - name: DEFAULT_USER_ROLE
          value: "pending"
        # Allow generating API keys from the UI (Settings → Account).
        - name: ENABLE_API_KEYS
          value: "true"
        # Use a small dedicated model for background tasks (title generation,
        # web search query rewriting) so the main chat model is not interrupted.
        # qwen3.5-0.8b-4k is always available regardless of hardware tier. The
        # value must match Open WebUI's model ID exactly, ":latest" included;
        # otherwise it silently falls back to the chat model.
        - name: TASK_MODEL
          value: "qwen3.5-0.8b-4k:latest"
        # The task model thinks by default and Ollama 0.40.x ignores a
        # "/no_think" prompt; without this, short tasks spend their whole
        # token budget thinking and return nothing.
        - name: TASK_MODEL_PARAMS
          value: '{"think": false}'
{% if not llm_chat_thinking | bool %}
        # Chat models think before answering unless told otherwise, which on a
        # CPU host can take longer than the answer. Default to no thinking;
        # per-model settings and the per-chat toggle still override it.
        - name: DEFAULT_MODEL_PARAMS
          value: '{"think": false}'
{% endif %}
        # Cache the Ollama model list instead of re-fetching it on every request.
        - name: ENABLE_BASE_MODELS_CACHE
          value: "true"
        # Use Ollama for RAG embeddings instead of loading sentence-transformer
        # models locally inside open-webui. Without this, open-webui loads
        # PyTorch ML models into memory at runtime, consuming 1-2 GB that is
        # then unavailable to Ollama when loading chat models.
        # RAG works once the embedding model is pulled in Ollama
        # (pull-models.sh always pulls it). Until then, RAG is simply inactive.
        - name: RAG_EMBEDDING_ENGINE
          value: "ollama"
        # Without this, Open WebUI asks Ollama for its sentence-transformers
        # default model name, which Ollama does not have.
        - name: RAG_EMBEDDING_MODEL
          value: "embeddinggemma:300m"
        # Web search via SearXNG sidecar (localhost:8888 — shared pod network).
        - name: ENABLE_RAG_WEB_SEARCH
          value: "true"
        - name: RAG_WEB_SEARCH_ENGINE
          value: "searxng"
        - name: SEARXNG_QUERY_URL
          value: "http://localhost:8888/search?q=<query>&format=json"
        # Secret key for session signing — read from the Kubernetes Secret.
        - name: WEBUI_SECRET_KEY
          valueFrom:
            secretKeyRef:
              name: llm-companion-secrets
              key: webui-secret-key
      livenessProbe:
        httpGet:
          path: /health
          port: 3000
        initialDelaySeconds: 30
        periodSeconds: 30
        timeoutSeconds: 10
      readinessProbe:
        httpGet:
          path: /health
          port: 3000
        initialDelaySeconds: 30
        periodSeconds: 10
        timeoutSeconds: 10
      # Verifies that Alembic migrations completed before liveness/readiness
      # probes take over. /health returns 200 even with a broken schema, so
      # this probe catches migration failures the HTTP probes would miss.
      startupProbe:
        exec:
          command:
            - python3
            - -c
            - |
              import sqlite3, os, sys
              db = '/app/backend/data/webui.db'
              if not os.path.exists(db):
                  sys.exit(0)
              try:
                  c = sqlite3.connect(db)
                  c.execute('SELECT version_num FROM alembic_version').fetchone()
                  c.close()
              except Exception:
                  sys.exit(1)
        initialDelaySeconds: 5
        failureThreshold: 3
        periodSeconds: 10
        timeoutSeconds: 5
      resources:
        requests:
          cpu: 100m
          memory: 512Mi
        limits:
          cpu: 500m
          memory: 2Gi
      volumeMounts:
        - name: open-webui-data
          mountPath: /app/backend/data

    # ── Open Terminal ────────────────────────────────────────────────────────
    # Remote shell for Open WebUI agents — internal only, never exposed outside
    # the pod. Connect via Admin → Connections → Open Terminal in Open WebUI,
    # using http://localhost:8000 and the key from open-terminal-api-key.env.
    - name: open-terminal # NOSONAR — storage limits inapplicable to podman play kube
      image: ghcr.io/open-webui/open-terminal:0.18.6-slim
      env:
        - name: OPEN_TERMINAL_API_KEY
          valueFrom:
            secretKeyRef:
              name: llm-companion-secrets
              key: open-terminal-api-key
      livenessProbe:
        exec:
          command:
            - sh
            - -c
            - "grep -q ':1F40 ' /proc/net/tcp /proc/net/tcp6 2>/dev/null"
        initialDelaySeconds: 10
        periodSeconds: 30
        timeoutSeconds: 5
      readinessProbe:
        exec:
          command:
            - sh
            - -c
            - "grep -q ':1F40 ' /proc/net/tcp /proc/net/tcp6 2>/dev/null"
        initialDelaySeconds: 10
        periodSeconds: 10
        timeoutSeconds: 5
      resources:
        requests:
          cpu: 50m
          memory: 64Mi
        limits:
          cpu: 1000m
          memory: 2Gi
      # NOTE: Open Terminal uses gosu to switch from root to the "user" account
      # at startup. In rootless Podman with keep-id, the process starts as the
      # host user (UID 1000) which lacks the effective CAP_SETUID needed by gosu.
      # Running as UID 0 (user-namespace root — not actual system root) gives gosu
      # the capability to call setuid(), after which the process drops back to the
      # "user" account as intended.
      securityContext:
        runAsUser: 0
      volumeMounts:
        - name: open-terminal-data
          mountPath: /home/user

    # ── SearXNG ──────────────────────────────────────────────────────────────
    # Internal-only metasearch engine used by Open WebUI for web search.
    # Not exposed outside the pod — reachable only on localhost:8888.
    - name: searxng # NOSONAR — storage limits inapplicable to podman play kube
      image: docker.io/searxng/searxng:2026.10.7-6671d89be
      env:
        # Bind on port 8888 to avoid conflicting with Caddy's :8080.
        - name: SEARXNG_PORT
          value: "8888"
        # Skip ownership enforcement — running rootless with keep-id mapping.
        - name: FORCE_OWNERSHIP
          value: "false"
        - name: INSTANCE_NAME
          value: "llm-companion"
        # Overrides server.secret_key (signs SearXNG's cookies and URLs).
        - name: SEARXNG_SECRET
          valueFrom:
            secretKeyRef:
              name: llm-companion-secrets
              key: searxng-secret-key
      livenessProbe:
        exec:
          command:
            - wget
            - -qO
            - /dev/null
            - http://localhost:8888/
        initialDelaySeconds: 10
        periodSeconds: 30
        timeoutSeconds: 5
      readinessProbe:
        exec:
          command:
            - wget
            - -qO
            - /dev/null
            - http://localhost:8888/
        initialDelaySeconds: 10
        periodSeconds: 10
        timeoutSeconds: 5
      resources:
        requests:
          cpu: 50m
          memory: 128Mi
        limits:
          cpu: 500m
          memory: 512Mi
      securityContext:
        capabilities:
          drop:
            - ALL
      volumeMounts:
        - name: searxng-config
          mountPath: /etc/searxng/
          readOnly: true
        - name: searxng-cache
          mountPath: /var/cache/searxng/

    # ── Caddy ────────────────────────────────────────────────────────────────
    - name: caddy # NOSONAR — Podman pod, not Kubernetes; S6864/S6870/S6873/S6892/S6897 are inapplicable
      image: docker.io/library/caddy:2.11.9
      env:
        # API key for Ollama Bearer token auth — read from the Kubernetes Secret.
        - name: OLLAMA_API_KEY
          valueFrom:
            secretKeyRef:
              name: llm-companion-secrets
              key: ollama-api-key
{% if llm_tls_hostnames %}
        # TLS on (llm_tls_hostnames): certificates from Caddy's local CA for
        # these names plus localhost, no HTTP-to-HTTPS redirect. See the
        # placeholders in caddy/Caddyfile.
        - name: LLM_AUTO_HTTPS
          value: "disable_redirects"
        - name: LLM_TLS
          value: "tls internal"
        - name: LLM_SITE_ADDRESS
          value: "{{ (['localhost'] + llm_tls_hostnames) | unique | map('regex_replace', '^(.*:.*)$', '[\\1]') | map('regex_replace', '$', ':8080') | join(', ') }}"
{% endif %}
      ports:
        # Publish Caddy's port to the host.
        - containerPort: 8080
          hostPort: 8080
          protocol: TCP
      livenessProbe:
        exec:
          command:
            - caddy
            - validate
            - --config
            - /etc/caddy/Caddyfile
        initialDelaySeconds: 5
        periodSeconds: 30
        timeoutSeconds: 10
      readinessProbe:
        tcpSocket:
          port: 8080
        initialDelaySeconds: 5
        periodSeconds: 10
        timeoutSeconds: 5
      resources:
        requests:
          cpu: 50m
          memory: 64Mi
        limits:
          cpu: 200m
          memory: 256Mi
      # NOTE: No cap-drop: ALL for Caddy.
      # Caddy has cap_net_bind_service as a file capability in the image.
      # Dropping ALL capabilities in a rootless user namespace causes EPERM
      # when Caddy tries to bind privileged ports (even :8080 on some kernels).
      # The securityContext block is intentionally omitted here.
      volumeMounts:
        # Mount the full ConfigMap directory so Caddyfile lands at /etc/caddy/Caddyfile.
        - name: caddyfile
          mountPath: /etc/caddy/
          readOnly: true
        - name: caddy-data
          mountPath: /data

  volumes:
    - name: ollama-models
      persistentVolumeClaim:
        claimName: llm-ollama-models
    - name: open-webui-data
      persistentVolumeClaim:
        claimName: llm-open-webui-data
    - name: caddy-data
      persistentVolumeClaim:
        claimName: llm-caddy-data
    # ConfigMap volume: mounts the embedded Caddyfile into the Caddy container.
    - name: caddyfile
      configMap:
        name: llm-companion-config
        items:
          - key: Caddyfile
            path: Caddyfile
    - name: open-terminal-data
      persistentVolumeClaim:
        claimName: llm-open-terminal-data
    # ConfigMap volume: mounts settings.yml into the SearXNG container.
    - name: searxng-config
      configMap:
        name: llm-companion-config
        items:
          - key: searxng-settings.yml
            path: settings.yml
    # Ephemeral cache for SearXNG — no persistence needed across restarts.
    - name: searxng-cache
      emptyDir: {}
